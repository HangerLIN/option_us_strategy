          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  run_id as \"回测ID\",\n  strategy_code as \"策略\",\n  parameters->>'symbol' as \"股票\",\n  status as \"状态\",\n  TO_CHAR(started_at, 'YYYY-MM-DD HH24:MI') as \"开始时间\",\n  TO_CHAR(completed_at, 'YYYY-MM-DD HH24:MI') as \"完成时间\",\n  EXTRACT(EPOCH FROM (completed_at - started_at)) as \"耗时(秒)\"\nFROM bt_runs\nWHERE status = 'COMPLETED'\nORDER BY run_id DESC\nLIMIT 20;",
          "refId": "A",
