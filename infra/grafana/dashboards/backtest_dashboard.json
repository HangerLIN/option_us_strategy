          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  metric_code as \"指标名称\", \n  ROUND(metric_value::numeric, 6) as \"值\",\n  CASE \n    WHEN metric_code LIKE 'RET_%' THEN ROUND(metric_value::numeric * 100, 2) || '%'\n    WHEN metric_code LIKE 'HIT_%' THEN ROUND(metric_value::numeric * 100, 0) || '%'\n    ELSE ROUND(metric_value::numeric, 2)::text\n  END as \"格式化\"\nFROM bt_metrics_total\nWHERE run_id = 126\nORDER BY metric_code;",
          "refId": "A"
        }
      ],
